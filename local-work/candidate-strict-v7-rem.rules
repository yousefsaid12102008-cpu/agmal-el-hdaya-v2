function p3Alloc(s,i){return s.invoiceDiscount==0?s.lines[i].invoiceDiscount==0:p3AllocNonzero(s,i);} function p3AllocNonzero(s,i){let n=s.subtotal-s.lineDiscount==0?1:s.subtotal-s.lineDiscount;let nums=[s.invoiceDiscount*s.lines[0].net,s.lines.size()>1?s.invoiceDiscount*s.lines[1].net:0,s.lines.size()>2?s.invoiceDiscount*s.lines[2].net:0];let rs=[nums[0]%n,nums[1]%n,nums[2]%n];let r=rs[i];let left=int((rs[0]+rs[1]+rs[2]) / n);let rank=((rs[0]>r || (rs[0]==r && 0<i))?1:0)+((s.lines.size()>1 && (rs[1]>r || (rs[1]==r && 1<i)))?1:0)+((s.lines.size()>2 && (rs[2]>r || (rs[2]==r && 2<i)))?1:0);return s.lines[i].invoiceDiscount==int((nums[i]-r) / n)+(rank<left?1:0);}
function p3LineMath(s,i){let l=s.lines[i];return p3LineShape(l) && l.quantity is int && l.quantity>0 && l.quantity<=1000000 && p3Money(l.unitPrice) && p3Money(l.gross) && l.gross==l.quantity*l.unitPrice && p3Money(l.discount) && l.discount<=l.gross && l.net==l.gross-l.discount && p3Money(l.invoiceDiscount) && l.invoiceDiscount<=l.net && p3Alloc(s,i) && l.payable==l.net-l.invoiceDiscount && (l.discount==0 || p3Can('discount_sales'));} function p3LineShape(l){return l.keys().hasAny(['custom']) ? (l.custom==true && l.keys().hasOnly(['custom','product','name','code','color','group','unit','factor','quantity','baseQuantity','savedUnitPrice','unitPrice','gross','discount','net','invoiceDiscount','payable']) && l.product=='custom' && l.name is string && l.name.size()>0 && l.name.size()<=150 && l.code=='' && l.color=='' && l.group=='' && l.unit=='piece' && l.factor==1 && l.baseQuantity==0 && l.savedUnitPrice==l.unitPrice && l.unitPrice>0) : (l.keys().hasOnly(['product','name','code','color','group','unit','factor','quantity','baseQuantity','savedUnitPrice','unitPrice','gross','discount','net','invoiceDiscount','payable']) && p3Id(l.product) && l.factor is int && l.factor>0 && p3Money(l.baseQuantity) && l.baseQuantity==l.quantity*l.factor);}
function p3Proof(s,i){let custom=s.lines[i].get('custom',false)==true;let p=custom?getAfter(/databases/$(database)/documents/phase3_custom_line_proofs/$('custom3_'+s.operationId+'_'+string(i))).data:getAfter(/databases/$(database)/documents/phase3_movements/$('sale3_'+s.operationId+'_'+string(i))).data;return p.saleId==s.operationId && p.index==i;} function p3CustomProof(m,id){let s=p3Sale(m.saleId);return p3New(m.saleId) && m.keys().hasOnly(['kind','saleId','index','actor','at']) && m.kind=='nonstock-line' && m.actor==request.auth.uid && m.at==request.time && m.index is int && m.index>=0 && m.index<s.lines.size() && id=='custom3_'+m.saleId+'_'+string(m.index) && s.lines[m.index].get('custom',false)==true && p3LineMath(s,m.index);} match /phase3_custom_line_proofs/{id}{allow read:if isOwner() || (p3Can('view_sales') && allowedWarehouse(g8(resource.data.saleId).warehouse));allow create:if p3CustomProof(request.resource.data,id);}
