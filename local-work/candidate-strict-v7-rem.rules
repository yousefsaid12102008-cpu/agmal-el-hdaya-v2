rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {
function zAk(){return request.resource.data.diff(resource.data).affectedKeys();}
function h0(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;}function h1(){return getAfter(/databases/$(database)/documents/role_settings/director).data;}function h2(){return get(/databases/$(database)/documents/role_settings/director).data;}function h3(){return getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetUid)).data;}function h4(){return get(/databases/$(database)/documents/users/$(request.resource.data.targetUid)).data;}function h5(){return getAfter(/databases/$(database)/documents/phase3_counters/invoices).data;}
function acctA(x){return getAfter(/databases/$(database)/documents/phase3_accounts/$(x)).data;}function acctG(x){return get(/databases/$(database)/documents/phase3_accounts/$(x)).data;}function custA(x){return getAfter(/databases/$(database)/documents/phase3_customers/$(x)).data;}function supTA(x){return getAfter(/databases/$(database)/documents/phase4_supplier_totals/$(x)).data;}
function g1(x){return getAfter(/databases/$(database)/documents/movements/$(x)).data;}function g2(x){return exists(/databases/$(database)/documents/movements/$(x));}function g3(x){return get(/databases/$(database)/documents/phase3_customers/$(x)).data;}function g4(x){return getAfter(/databases/$(database)/documents/phase3_invoice_alias/$(x)).data;}function g5(x){return getAfter(/databases/$(database)/documents/phase3_orders/$(x)).data;}function g6(x){return get(/databases/$(database)/documents/phase3_orders/$(x)).data;}function g7(x){return getAfter(/databases/$(database)/documents/phase3_sales/$(x)).data;}function g8(x){return get(/databases/$(database)/documents/phase3_sales/$(x)).data;}function g9(x){return get(/databases/$(database)/documents/phase3_tariffs/$(x)).data;}function g10(x){return getAfter(/databases/$(database)/documents/phase4_collection_reversals/$(x)).data;}function g11(x){return getAfter(/databases/$(database)/documents/phase4_collections/$(x)).data;}function g12(x){return getAfter(/databases/$(database)/documents/phase4_debt_opening_voids/$(x)).data;}function g13(x){return getAfter(/databases/$(database)/documents/phase4_debt_receipt_reversals/$(x)).data;}function g14(x){return getAfter(/databases/$(database)/documents/phase4_debt_receipts/$(x)).data;}function g15(x){return getAfter(/databases/$(database)/documents/phase4_purchases/$(x)).data;}function g16(x){return getAfter(/databases/$(database)/documents/phase4_supplier_payment_reversals/$(x)).data;}function g17(x){return getAfter(/databases/$(database)/documents/phase4_supplier_settlements/$(x)).data;}function g18(x){return getAfter(/databases/$(database)/documents/products/$(x)).data;}function g19(x){return get(/databases/$(database)/documents/products/$(x)).data;}function g20(x){return getAfter(/databases/$(database)/documents/stock/$(x)).data;}function g21(x){return get(/databases/$(database)/documents/warehouses/$(x)).data;}
function signedIn(){return request.auth != null;}
function summary(p){return {'status':p.status,'role':p.role,'permissions':p.permissions};}
function allowed(p){
return p.role in ['owner','director','customer','employee','cashier'] && p.permissions is list && p.permissions.size() == p.permissions.toSet().size() &&
((p.role in ['owner','director'] && p.status in ['active','suspended'] && p.permissions == []) || (p.role == 'customer' && p.permissions.hasOnly(['view_own_purchases','view_own_orders','view_own_account'])) ||
(p.role in ['employee','cashier'] && p.permissions.hasOnly(['view_sales','create_sales','cancel_sales','discount_sales','credit_sales','manage_prices','manage_services','view_inventory','manage_inventory','manage_customers','view_orders','manage_orders'])));
}
function auditMatches(uid,before,after,action){
let a=getAfter(/databases/$(database)/documents/audit_logs/$(after.lastAuditId)).data;
return after.lastAuditId is string && after.lastAuditId.size() > 0 && after.lastAuditId.size() <= 128 &&
!exists(/databases/$(database)/documents/audit_logs/$(after.lastAuditId)) &&
a.keys().hasOnly(['actorUid','action','targetUid','before','after','createdAt']) &&
a.actorUid == request.auth.uid && a.targetUid == uid && a.action == action && a.before == before &&
a.after == summary(after) && a.createdAt == request.time;
}
function register(uid){
let p=request.resource.data;
return signedIn() && request.auth.uid == uid &&
p.keys().hasAll(['uid','displayName','email','emailVerified','role','requestedRole','status','permissions','createdAt','updatedAt','lastAuditId']) &&
p.keys().hasOnly(['uid','displayName','email','emailVerified','role','requestedRole','status','permissions','createdAt','updatedAt','lastAuditId']) &&
p.uid == uid && p.displayName is string && p.displayName.size() <= 120 &&
p.email == request.auth.token.email && p.emailVerified == request.auth.token.email_verified &&
p.requestedRole in ['customer','employee','director'] && (p.requestedRole != 'director' || managerApplicationsOpen()) && p.role == 'customer' && p.status == 'pending' && p.permissions == [] &&
p.createdAt == request.time && p.updatedAt == request.time && auditMatches(uid,null,p,'user.requested');
}
function review(uid){
let old=resource.data; let p=request.resource.data;
return isOwner() && request.auth.uid != uid && (p.role != 'owner' || old.role == 'owner') && allowed(p) &&
p.diff(old).affectedKeys().hasOnly(['status','role','permissions','updatedAt','reviewedBy','lastAuditId']) &&
((old.status == 'pending' && p.status in ['active','rejected'] && (p.status != 'active' || old.emailVerified == true)) || (old.status == 'active' && p.status in ['active','suspended']) || (old.status == 'suspended' && p.status in ['active','suspended'])) &&
managerTransition(uid,old,p) && (p.status != 'active' || old.emailVerified == true) && p.updatedAt == request.time && p.reviewedBy == request.auth.uid &&
auditMatches(uid,summary(old),p,'user.reviewed');
}
function managerApplicationsOpen(){let c=h2();return c.open == true && c.used < c.capacity;}
function managerTransition(uid,old,p){
let delta=(p.role == 'director'?1:0)-(old.role == 'director'?1:0);
return delta == 0 || managerCounter(uid,p.lastAuditId,delta);
}
function managerCounter(uid,audit,delta){
let c=h2();
let n=h1();
return (delta < 0 || (c.open == true && c.used < c.capacity)) && n.used == c.used+delta && n.capacity == c.capacity && n.targetUid == uid && n.lastAuditId == audit && n.updatedAt == request.time && n.open == (c.open && n.used < c.capacity);
}
function configShape(c){return getAfter(/databases/$(database)/documents/role_availability/director).data == {'open':c.open && c.used<c.capacity} && c.keys().hasAll(['capacity','used','open','updatedAt','lastAuditId','targetUid']) && c.keys().hasOnly(['capacity','used','open','updatedAt','lastAuditId','targetUid']) && c.capacity is int && c.capacity >= 0 && c.capacity <= 1000 && c.used is int && c.used >= 0 && c.used <= c.capacity && c.open is bool && (!c.open || c.used < c.capacity) && c.updatedAt == request.time;}
function configAudit(c,before){let a=getAfter(/databases/$(database)/documents/role_capacity_audit/$(c.lastAuditId)).data;return !exists(/databases/$(database)/documents/role_capacity_audit/$(c.lastAuditId)) && a.keys().hasOnly(['actorUid','before','after','createdAt']) && a.actorUid == request.auth.uid && a.before == before && a.after == {'capacity':c.capacity,'used':c.used,'open':c.open} && a.createdAt == request.time;}
match /role_availability/director {
allow get: if true;
allow create,update: if isOwner() && request.resource.data.keys().hasOnly(['open']) && request.resource.data.open == (h1().open && h1().used < h1().capacity) && (!exists(/databases/$(database)/documents/role_settings/director) || h1().lastAuditId != h2().lastAuditId);
}
match /role_settings/director {
allow get: if isOwner();
allow create: if isOwner() && configShape(request.resource.data) && request.resource.data.used == 0 && request.resource.data.targetUid == '' && configAudit(request.resource.data,null);
allow update: if isOwner() && configShape(request.resource.data) && (
(request.resource.data.used == resource.data.used && request.resource.data.targetUid == '' && configAudit(request.resource.data,{'capacity':resource.data.capacity,'used':resource.data.used,'open':resource.data.open})) ||
((h3().role == 'director' || h4().role == 'director') && request.resource.data.targetUid is string && request.resource.data.targetUid != request.auth.uid && exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid)) && h3().lastAuditId == request.resource.data.lastAuditId && h4().get('lastAuditId','') != request.resource.data.lastAuditId && managerTransition(request.resource.data.targetUid,h4(),h3()) && h3().role != h4().role));
}
match /role_capacity_audit/{entry} {
allow read: if isOwner();
allow create: if isOwner() && h1().lastAuditId == entry && (!exists(/databases/$(database)/documents/role_settings/director) || h2().lastAuditId != entry);
}
match /users/{uid} {
allow get: if signedIn() && (request.auth.uid == uid || isOwner());
allow list: if isOwner();
allow create: if register(uid);
allow update: if review(uid) || (signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true && request.resource.data.email == request.auth.token.email && resource.data.emailVerified == false && request.resource.data.emailVerified == true && zAk().hasOnly(['emailVerified','updatedAt']) && request.resource.data.updatedAt == request.time);
}
match /audit_logs/{entry} {
allow read: if isOwner();
allow create: if signedIn() && request.resource.data.targetUid is string &&
h3().lastAuditId == entry &&
((!exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid)) && request.resource.data.action == 'user.requested' && request.resource.data.targetUid == request.auth.uid) ||
(isOwner() && exists(/databases/$(database)/documents/users/$(request.resource.data.targetUid)) && h4().get('lastAuditId','') != entry && request.resource.data.action == 'user.reviewed'));
}
match /roles/{role} {allow read: if isOwner(); }
match /permissions/{permission} {allow read: if isOwner(); }
function f4New(name,id){let s=getAfter(/databases/$(database)/documents/$(name)/$(id)).data;return isOwner() && p3Id(id) && !exists(/databases/$(database)/documents/$(name)/$(id)) && s.operationId==id && s.actor==request.auth.uid && s.at==request.time && s.intentFingerprint is string && s.intentFingerprint.size()<=2000;}
function f4Entry(e){return e.keys().hasOnly(['account','debit','credit']) && e.account is string && e.debit is int && e.credit is int && e.debit>=0 && e.credit>=0 && (e.debit==0||e.credit==0) && (e.debit>0||e.credit>0);}
function f4EntriesBalanced(l){return l is list && l.size()>=1 && l.size()<=3 && f4Entry(l[0]) && (l.size()>1?f4Entry(l[1]):true) && (l.size()>2?f4Entry(l[2]):true) && l[0].debit+(l.size()>1?l[1].debit:0)+(l.size()>2?l[2].debit:0)==l[0].credit+(l.size()>1?l[1].credit:0)+(l.size()>2?l[2].credit:0);}
function f4Change(c){return c.keys().hasOnly(['account','before','after']) && p3Id(c.account) && c.before is int && c.after is int;}
function f4AcctChain(list,i,id){return list.size()>i && f4Change(list[i]) && list[i].account==id && list[i].before==resource.data.balance && list[i].after==request.resource.data.balance;}
function f4FinValid(id){let d=request.resource.data;let isT=d.details.get('kind','')=='' && d.kind=='transfer';return f4New('phase4_finance',id) && d.keys().hasOnly(['operationId','kind','reason','changes','entries','revenue','expense','details','actor','at','intentFingerprint','actorShift','accountShifts']) && d.kind in ['transfer','expense','manual-service'] && d4Text(d.reason,500) && d.changes is list && d.changes.size()>=1 && d.changes.size()<=2 && f4Change(d.changes[0]) && (d.changes.size()<2||f4Change(d.changes[1])) && sh4Tags(d,d.changes.size()) && f4EntriesBalanced(d.entries) && d.revenue is int && d.expense is int && d.revenue>=0 && d.expense>=0 && (
(d.kind=='transfer' && d.details.keys().hasOnly(['from','to','amount','fee']) && p3Id(d.details.from) && p3Id(d.details.to) && p3Money(d.details.amount) && d.details.amount>0 && d.details.fee is int && d.details.fee>=0 && d.changes.size()==2 && d.revenue==0 && d.expense==0) ||
(d.kind=='expense' && d.details.keys().hasOnly(['account','category','amount']) && p3Id(d.details.account) && p3Id(d.details.category) && p3Money(d.details.amount) && d.details.amount>0 && d.changes.size()==1 && d.revenue==0 && d.expense==d.details.amount) ||
(d.kind=='manual-service' && d.details.keys().hasOnly(['source','receipt','principal','commission','status']) && p3Money(d.details.principal) && d.details.commission is int && d.changes.size()==2)
);}
match /phase4_finance/{id}{allow read:if isOwner();allow create:if f4FinValid(id);}
function fAuto1(id){let d=request.resource.data;return f4New('phase4_finance_reversals',id) && d.keys().hasOnly(['operationId','originalId','originalKind','confirmedReversed','reason','reference','changes','entries','revenueReversed','expenseReversed','manualPrincipalReversed','manualRefundPaid','actor','at','intentFingerprint','actorShift','accountShifts']) && p3Id(d.originalId) && d.originalKind in ['transfer','expense','manual-service'] && d.confirmedReversed==true && d4Text(d.reason,500) && d.reference is string && d.reference.size()<=120 && get(/databases/$(database)/documents/phase4_finance/$(d.originalId)).data.operationId==d.originalId && getAfter(/databases/$(database)/documents/phase4_finance_reversal_refs/$(d.originalId)).data.reversalId==id && d.changes is list && d.changes.size()>=1 && d.changes.size()<=2 && f4Change(d.changes[0]) && (d.changes.size()<2||f4Change(d.changes[1])) && sh4Tags(d,d.changes.size()) && f4EntriesBalanced(d.entries);}
match /phase4_finance_reversals/{id}{allow read:if isOwner();allow create:if fAuto1(id);}
match /phase4_finance_reversal_refs/{id}{allow read:if isOwner();allow create:if isOwner() && p3Id(id) && !exists(/databases/$(database)/documents/phase4_finance_reversal_refs/$(id)) && request.resource.data.keys().hasOnly(['reversalId']) && getAfter(/databases/$(database)/documents/phase4_finance_reversals/$(request.resource.data.reversalId)).data.originalId==id;}
match /phase3_accounts/{id}{allow update:if zAk().hasOnly(['balance','lastFinance']) && p3Id(request.resource.data.lastFinance) && (
f4AcctChain(getAfter(/databases/$(database)/documents/phase4_finance/$(request.resource.data.lastFinance)).data.changes,0,id) ||
f4AcctChain(getAfter(/databases/$(database)/documents/phase4_finance/$(request.resource.data.lastFinance)).data.changes,1,id));}
match /phase3_accounts/{id}{allow update:if zAk().hasOnly(['balance','lastFinanceReversal']) && p3Id(request.resource.data.lastFinanceReversal) && (
f4AcctChain(getAfter(/databases/$(database)/documents/phase4_finance_reversals/$(request.resource.data.lastFinanceReversal)).data.changes,0,id) ||
f4AcctChain(getAfter(/databases/$(database)/documents/phase4_finance_reversals/$(request.resource.data.lastFinanceReversal)).data.changes,1,id));}
function f4ColValid(id){let d=request.resource.data;let s=g8(d.saleId);return isOwner() && p3Id(id) && !exists(/databases/$(database)/documents/phase4_collections/$(id)) && d.operationId==id && d.actor==request.auth.uid && d.at==request.time && d.intentFingerprint is string && d.intentFingerprint.size()<=2000 && d.keys().hasOnly(['operationId','saleId','account','amount','reference','customer','warehouse','actor','at','intentFingerprint','actorShift','accountShifts']) && p3Id(d.saleId) && p3Id(d.account) && p3Money(d.amount) && d.amount>0 && d.reference is string && d.reference.size()>0 && d.reference.size()<=120 && sh4Tags(d,1) && s.customer==d.customer && s.warehouse==d.warehouse && getAfter(/databases/$(database)/documents/phase4_sale_collections/$(d.saleId)).data.lastCollection==id && getAfter(/databases/$(database)/documents/phase4_sale_collections/$(d.saleId)).data.amount==(exists(/databases/$(database)/documents/phase4_sale_collections/$(d.saleId))?get(/databases/$(database)/documents/phase4_sale_collections/$(d.saleId)).data.amount:0)+d.amount && custA(d.customer).lastCollection==id && custA(d.customer).due==g3(d.customer).due-d.amount && acctA(d.account).lastCollection==id && acctA(d.account).balance==acctG(d.account).balance+d.amount;}
match /phase4_collections/{id}{allow create:if f4ColValid(id);}
match /phase4_sale_collections/{id}{allow read:if isOwner();allow create:if isOwner() && request.resource.data.keys().hasOnly(['amount','lastCollection','lastCollectionReversal']) && p3Id(request.resource.data.get('lastCollection','')) && g11(request.resource.data.lastCollection).saleId==id;allow update:if zAk().hasOnly(['amount','lastCollection','lastCollectionReversal']) && ((request.resource.data.get('lastCollection','')!='' && g11(request.resource.data.get('lastCollection','')).saleId==id) || (request.resource.data.get('lastCollectionReversal','')!='' && g10(request.resource.data.get('lastCollectionReversal','')).saleId==id && request.resource.data.amount==resource.data.amount-g10(request.resource.data.get('lastCollectionReversal','')).amount));}
match /phase3_customers/{id}{allow update:if zAk().hasOnly(['due','lastCollection']) && p3Id(request.resource.data.lastCollection) && g11(request.resource.data.lastCollection).customer==id && request.resource.data.due==resource.data.due-g11(request.resource.data.lastCollection).amount;}
match /phase3_customers/{id}{allow update:if zAk().hasOnly(['due','lastCollectionReversal']) && p3Id(request.resource.data.lastCollectionReversal) && g10(request.resource.data.lastCollectionReversal).customer==id && request.resource.data.due==resource.data.due+g10(request.resource.data.lastCollectionReversal).amount;}
match /phase3_accounts/{id}{allow update:if zAk().hasOnly(['balance','lastCollection']) && p3Id(request.resource.data.lastCollection) && g11(request.resource.data.lastCollection).account==id && request.resource.data.balance==resource.data.balance+g11(request.resource.data.lastCollection).amount;}
match /phase3_accounts/{id}{allow update:if zAk().hasOnly(['balance','lastCollectionReversal']) && p3Id(request.resource.data.lastCollectionReversal) && g10(request.resource.data.lastCollectionReversal).account==id && request.resource.data.balance==resource.data.balance-g10(request.resource.data.lastCollectionReversal).amount;}
function fAuto2(id){let d=request.resource.data;let o=get(/databases/$(database)/documents/phase4_collections/$(d.originalId)).data;return isOwner() && p3Id(id) && !exists(/databases/$(database)/documents/phase4_collection_reversals/$(id)) && d.operationId==id && d.actor==request.auth.uid && d.at==request.time && d.intentFingerprint is string && d.intentFingerprint.size()<=2000 && d.keys().hasOnly(['operationId','originalId','saleId','customer','warehouse','account','amount','confirmedRefunded','reason','reference','collectedBefore','collectedAfter','invoiceDueBefore','invoiceDueAfter','customerDueBefore','customerDueAfter','accountBefore','accountAfter','returnDebtReductionObserved','returnOperationObserved','returnRefundObserved','entries','actor','at','intentFingerprint','actorShift','accountShifts']) && p3Id(d.originalId) && d.confirmedRefunded==true && d4Text(d.reason,500) && d.reference is string && d.reference.size()<=120 && d.saleId==o.saleId && d.customer==o.customer && d.warehouse==o.warehouse && d.account==o.account && d.amount==o.amount && d.collectedAfter==d.collectedBefore-d.amount && d.customerDueAfter==d.customerDueBefore+d.amount && d.accountAfter==d.accountBefore-d.amount && d.accountBefore==acctG(d.account).balance && !exists(/databases/$(database)/documents/phase4_collection_reversal_refs/$(d.originalId)) && getAfter(/databases/$(database)/documents/phase4_collection_reversal_refs/$(d.originalId)).data.reversalId==id && custA(d.customer).lastCollectionReversal==id && acctA(d.account).lastCollectionReversal==id && f4EntriesBalanced(d.entries) && sh4Tags(d,1);}
match /phase4_collection_reversals/{id}{allow read:if isOwner();allow create:if fAuto2(id);}
match /phase4_collection_reversal_refs/{id}{allow read:if isOwner();allow create:if isOwner() && p3Id(id) && !exists(/databases/$(database)/documents/phase4_collection_reversal_refs/$(id)) && request.resource.data.keys().hasOnly(['reversalId']) && g10(request.resource.data.reversalId).originalId==id;}
function f4PoValid(id){let d=request.resource.data;let stA=g20(d.product+'~'+d.warehouse);let stB=get(/databases/$(database)/documents/stock/$(d.product+'~'+d.warehouse)).data;let totA=supTA(d.supplier);let hasTot=exists(/databases/$(database)/documents/phase4_supplier_totals/$(d.supplier));let prod=g19(d.product);return f4New('phase4_purchases',id) && d.keys().hasOnly(['operationId','supplier','warehouse','product','confirmedReceived','reason','reference','quantity','unit','expectedFactor','unitCost','discount','expectedTotal','paid','account','name','code','group','color','factor','baseQuantity','subtotal','total','due','actor','at','entries','intentFingerprint','actorShift','accountShifts']) && d.confirmedReceived==true && d4Text(d.reason,500) && d.reference is string && d.reference.size()<=120 && d.quantity is int && d.quantity>0 && p3Money(d.unitCost) && d.discount is int && d.discount>=0 && p3Money(d.paid) && (d.paid>0)==(d.account is string) && (d.paid==0||p3Id(d.account)) && f4EntriesBalanced(d.entries) && sh4Tags(d,1) && d.subtotal==d.quantity*d.unitCost && d.discount<=d.subtotal && d.total==d.subtotal-d.discount && d.expectedTotal==d.total && d.paid<=d.total && d.due==d.total-d.paid && d.factor is int && d.factor>=1 && d.expectedFactor==d.factor && d.baseQuantity==d.quantity*d.factor && get(/databases/$(database)/documents/suppliers/$(d.supplier)).data.active==true && g21(d.warehouse).active==true && prod.active==true && prod.units.get(d.unit,0)==d.factor && stA.qty==stB.qty+d.baseQuantity && stA.lastMovement=='purchase4_'+id && getAfter(/databases/$(database)/documents/phase4_purchase_movements/$('purchase4_'+id)).data.purchaseId==id && totA.lastPurchase==id && totA.due==(hasTot?get(/databases/$(database)/documents/phase4_supplier_totals/$(d.supplier)).data.due:0)+d.due && totA.purchasesTotal==(hasTot?get(/databases/$(database)/documents/phase4_supplier_totals/$(d.supplier)).data.purchasesTotal:0)+d.total && totA.paidTotal==(hasTot?get(/databases/$(database)/documents/phase4_supplier_totals/$(d.supplier)).data.paidTotal:0)+d.paid && (d.paid==0 || (acctA(d.account).lastPurchase==id && acctA(d.account).balance==acctG(d.account).balance-d.paid));}
match /phase4_purchases/{id}{allow read:if isOwner();allow create:if f4PoValid(id);}
function fAuto3(id){let d=request.resource.data;return isOwner() && id=='purchase4_'+d.purchaseId && p3Id(d.purchaseId) && !exists(/databases/$(database)/documents/phase4_purchase_movements/$(id)) && d.keys().hasOnly(['purchaseId','product','warehouse','delta','actor','at']) && d.actor==request.auth.uid && d.at==request.time && g15(d.purchaseId).baseQuantity==d.delta && g15(d.purchaseId).product==d.product && g15(d.purchaseId).warehouse==d.warehouse;}
match /phase4_purchase_movements/{id}{allow read:if isOwner();allow create:if fAuto3(id);}
function fAuto8(key){let m=request.resource.data.lastMovement;let mv=getAfter(/databases/$(database)/documents/phase4_purchase_movements/$(m)).data;return zAk().hasOnly(['qty','lastMovement']) && m is string && mv.product+'~'+mv.warehouse==key && request.resource.data.qty==resource.data.qty+mv.delta;}
match /stock/{key}{allow update:if fAuto8(key);}
match /phase3_accounts/{id}{allow update:if zAk().hasOnly(['balance','lastPurchase']) && p3Id(request.resource.data.lastPurchase) && g15(request.resource.data.lastPurchase).account==id && request.resource.data.balance==resource.data.balance-g15(request.resource.data.lastPurchase).paid;}
