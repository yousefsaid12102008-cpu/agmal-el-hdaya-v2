function mxDisc(j){return j.discountType in ['none','amount','percent'] && p3Money(j.discountValue) && p3Money(j.discountAmount) && p3Money(j.additionAmount) && j.discountAmount<=j.subtotal && (j.discountType=='none' ? j.discountValue==0 && j.discountAmount==0 : (j.discountType=='amount' ? j.discountAmount==j.discountValue : j.discountValue<=10000 && j.discountAmount==int((j.subtotal*j.discountValue+5000) / 10000))) && (j.discountAmount==0 || p3Can('discount_sales')) && mxTax(j);}
function mxTax(j){let b=j.subtotal-j.discountAmount+j.additionAmount;return j.taxType in ['none','amount','percent'] && p3Money(j.taxValue) && p3Money(j.taxAmount) && (j.taxType=='none' ? j.taxValue==0 && j.taxAmount==0 : (j.taxType=='amount' ? j.taxAmount==j.taxValue : j.taxValue<=10000 && j.taxAmount==int((b*j.taxValue+5000) / 10000))) && j.total==b+j.taxAmount;}
function mxCounts(j,t4,t5){return j.a4s is int && j.a4d is int && j.a5s is int && j.a5d is int && j.copies is int && j.a4s>=0 && j.a4d>=0 && j.a5s>=0 && j.a5d>=0 && j.a4s<=1000000 && j.a4d<=1000000 && j.a5s<=1000000 && j.a5d<=1000000 && j.copies>=1 && j.copies<=1000000 && (j.a4s+j.a4d+j.a5s+j.a5d)>0 && (j.a4d==0 || t4.duplexAllowed==true) && (j.a5d==0 || t5.duplexAllowed==true) && j.sheets4==(j.a4s+j.a4d)*j.copies && j.sheets5==(j.a5s+j.a5d)*j.copies && j.sheets==j.sheets4+j.sheets5 && j.impressions==(j.a4s+2*j.a4d+j.a5s+2*j.a5d)*j.copies && j.counterIncrement==j.impressions && p3Money(j.impressions);}
function mxPrice(j,t4,t5){return j.p4s==t4.singleSheetPrice && j.p4d==t4.duplexSheetPrice && j.p5s==t5.singleSheetPrice && j.p5d==t5.duplexSheetPrice && j.subtotal==j.copies*(j.a4s*j.p4s+j.a4d*j.p4d+j.a5s*j.p5s+j.a5d*j.p5d) && p3Money(j.subtotal) && mxDisc(j);}
function mxActual(j,t4,t5){return j.actualSheets4 is int && j.actualSheets5 is int && j.actualSheets4>=j.sheets4 && j.actualSheets5>=j.sheets5 && j.wasted4==j.actualSheets4-j.sheets4 && j.wasted5==j.actualSheets5-j.sheets5 && j.expectedSheets4==j.sheets4 && j.expectedSheets5==j.sheets5 && j.counterBefore is int && j.counterAfter is int && j.counterAfter>=j.counterBefore+j.impressions && j.actualImpressions==j.counterAfter-j.counterBefore && j.reason is string && j.reason.size()<=500 && ((j.wasted4==0 && j.wasted5==0 && j.actualImpressions==j.impressions) || j.reason.size()>0) && j.costPiastres==mxCost(j,t4,t5) && j.marginPiastres==j.total-j.taxAmount-j.costPiastres && p3Money(j.costPiastres) && j.actualCostPiastres==j.costPiastres+j.wasted4*t4.costSinglePiastres+j.wasted5*t5.costSinglePiastres && p3Money(j.actualCostPiastres) && j.actualMarginPiastres==j.total-j.taxAmount-j.actualCostPiastres;}
function mxCost(j,t4,t5){return j.copies*(j.a4s*t4.costSinglePiastres+j.a4d*t4.costDuplexPiastres+j.a5s*t5.costSinglePiastres+j.a5d*t5.costDuplexPiastres);}
function mxValid(j,id){
let t4=g9(j.a4Tariff);
let t5=g9(j.a5Tariff);
let m=get(/databases/$(database)/documents/phase3_machines/$(j.machine)).data;
let ma=getAfter(/databases/$(database)/documents/phase3_machines/$(j.machine)).data;
let post=getAfter(/databases/$(database)/documents/phase3_service_postings_v2/$(id)).data;
return j.schemaVersion==3 && p3Can('manage_services') && p3Can('create_sales') && j.actor==request.auth.uid && j.at==request.time && allowedWarehouse(j.warehouse) && sh4Tags(j,j.payments.size()) && p3Id(id) && j.operationId==id
&& j.keys().hasOnly(['actorShift','accountShifts','schemaVersion','pricingMode','name','a4s','a4d','a5s','a5d','copies','sheets4','sheets5','sheets','impressions','counterIncrement','p4s','p4d','p5s','p5d','subtotal','discountType','discountValue','discountAmount','additionAmount','taxType','taxValue','taxAmount','total','costPiastres','marginPiastres','a4Tariff','a5Tariff','a4Product','a5Product','expectedSheets4','expectedSheets5','actualSheets4','actualSheets5','wasted4','wasted5','counterBefore','counterAfter','actualImpressions','reason','actualCostPiastres','actualMarginPiastres','operationId','machine','warehouse','reference','actor','at','intentFingerprint','payments','customer','paid','due','confirmedDebt'])
&& j.pricingMode=='mixed' && j.name=='طباعة مجمعة' && j.a4Tariff!=j.a5Tariff && j.a4Product!=j.a5Product
&& t4.active==true && t5.active==true && t4.get('pricingMode','impression')=='sheet' && t5.get('pricingMode','impression')=='sheet' && t4.get('tiers',[]).size()==0 && t5.get('tiers',[]).size()==0 && t4.paperProduct==j.a4Product && t5.paperProduct==j.a5Product
&& m.active==true && m.tariff in [j.a4Tariff,j.a5Tariff] && m.warehouse==j.warehouse && g21(j.warehouse).active==true && j.counterBefore==m.counter && ma.counter==j.counterAfter && ma.lastJobV3==id
&& j.reference is string && j.reference.size()>0 && j.reference.size()<=120 && j.intentFingerprint is string && j.intentFingerprint.size()<=20000
&& g20(j.a4Product+'~'+j.warehouse).lastMovement=='print4_'+id && g20(j.a5Product+'~'+j.warehouse).lastMovement=='print4_'+id
&& !exists(/databases/$(database)/documents/phase3_service_postings_v2/$(id)) && post.sourceId==id && post.actor==j.actor && post.at==request.time;
}
function mxStockOk(key){let id=request.resource.data.lastMovement.replace('^print4_','');let j=svJob(id);let a4=key==j.a4Product+'~'+j.warehouse;let a5=key==j.a5Product+'~'+j.warehouse;let pr=g19(a4?j.a4Product:j.a5Product);return svNew(id) && j.schemaVersion==3 && (a4||a5) && pr.active==true && pr.baseUnit=='sheet' && pr.units.sheet==1 && resource.data.product==(a4?j.a4Product:j.a5Product) && resource.data.warehouse==j.warehouse && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty','lastMovement']) && request.resource.data.qty==resource.data.qty-(a4?j.actualSheets4:j.actualSheets5) && p3Money(request.resource.data.qty) && request.resource.data.qty>=resource.data.get('reservedQty',0);}
function mxTar(id){return g9(id);}
function mxMachineProof(j){let t4=mxTar(j.a4Tariff);let t5=mxTar(j.a5Tariff);return mxCounts(j,t4,t5) && mxActual(j,t4,t5);}
function mxPostingProof(j){return mxPrice(j,mxTar(j.a4Tariff),mxTar(j.a5Tariff));}
match /phase3_service_jobs/{id}{allow create:if request.resource.data.get('schemaVersion',1)==3 && mxValid(request.resource.data,id);}
match /stock/{key}{allow update:if request.resource.data.lastMovement.matches('print4_.*') && mxStockOk(key);}
function mxMach(id,jid){let j=svJob(jid);return svNew(jid) && j.schemaVersion==3 && j.machine==id && resource.data.counter==j.counterBefore && request.resource.data.counter==j.counterAfter && mxMachineProof(j);}
match /phase3_machines/{id}{allow update:if zAk().hasOnly(['counter','lastJobV3']) && zAk().hasAny(['lastJobV3']) && mxMach(id,request.resource.data.lastJobV3);}
match /phase4_reminders/{id}{allow read:if isOwner();allow create:if isOwner() && p3Id(id) && request.resource.data.keys().hasOnly(['customer','actor','at','channel']) && p3Id(request.resource.data.customer) && request.resource.data.actor==request.auth.uid && request.resource.data.at==request.time && request.resource.data.channel=='manual';}
}
}